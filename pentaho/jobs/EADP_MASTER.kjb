    <entry>
      <name>LOG_MASTER_START</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO audit.etl_execution_log (
    job_name,
    transformation_name,
    source_name,
    target_table,
    start_time,
    status
)
VALUES (
    'EADP_MASTER',
    NULL,
    'ALL_SOURCES',
    'ALL_WAREHOUSE_TABLES',
    CURRENT_TIMESTAMP,
    'RUNNING'
);</sql>
