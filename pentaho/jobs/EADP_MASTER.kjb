    </entry>
    <entry>
      <name>VALIDATE_STAGING</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>
SELECT
    CASE
        WHEN bool_and(row_count > 0) THEN 'SUCCESS'
        ELSE 'FAILED'
    END AS validation_status,
    COUNT(*) FILTER (WHERE row_count > 0) AS non_empty_tables,
    COUNT(*) AS total_tables
FROM (
    SELECT 'stg_aircraft_iot' AS table_name,
           (SELECT COUNT(*) FROM staging.stg_aircraft_iot) AS row_count
    UNION ALL
    SELECT 'stg_aircraft_maintenance',
           (SELECT COUNT(*) FROM staging.stg_aircraft_maintenance)
    UNION ALL
    SELECT 'stg_airport_operations',
           (SELECT COUNT(*) FROM staging.stg_airport_operations)
    UNION ALL
    SELECT 'stg_baggage_handling',
           (SELECT COUNT(*) FROM staging.stg_baggage_handling)
    UNION ALL
    SELECT 'stg_crew_scheduling',
           (SELECT COUNT(*) FROM staging.stg_crew_scheduling)
    UNION ALL
    SELECT 'stg_crm',
           (SELECT COUNT(*) FROM staging.stg_crm)
    UNION ALL
    SELECT 'stg_flight_delay',
           (SELECT COUNT(*) FROM staging.stg_flight_delay)
    UNION ALL
    SELECT 'stg_flight_operations',
           (SELECT COUNT(*) FROM staging.stg_flight_operations)
    UNION ALL
    SELECT 'stg_passenger_reservation',
           (SELECT COUNT(*) FROM staging.stg_passenger_reservation)
    UNION ALL
    SELECT 'stg_ticketing_booking',
           (SELECT COUNT(*) FROM staging.stg_ticketing_booking)
) s;
</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>EADP_POSTGRES</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>432</xloc>
      <yloc>272</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>VALIDATE_WAREHOUSE</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>
SELECT
    CASE
        WHEN bool_and(row_count > 0) THEN 'SUCCESS'
        ELSE 'FAILED'
    END AS validation_status,
    COUNT(*) FILTER (WHERE row_count > 0) AS non_empty_fact_tables,
    COUNT(*) AS total_fact_tables
FROM (
    SELECT 'fact_aircraft_iot' AS table_name,
           (SELECT COUNT(*) FROM warehouse.fact_aircraft_iot) AS row_count
    UNION ALL
    SELECT 'fact_baggage',
           (SELECT COUNT(*) FROM warehouse.fact_baggage)
    UNION ALL
    SELECT 'fact_booking',
           (SELECT COUNT(*) FROM warehouse.fact_booking)
    UNION ALL
    SELECT 'fact_crew_scheduling',
           (SELECT COUNT(*) FROM warehouse.fact_crew_scheduling)
    UNION ALL
    SELECT 'fact_flight_delay',
           (SELECT COUNT(*) FROM warehouse.fact_flight_delay)
    UNION ALL
    SELECT 'fact_flight_operations',
           (SELECT COUNT(*) FROM warehouse.fact_flight_operations)
    UNION ALL
    SELECT 'fact_maintenance',
           (SELECT COUNT(*) FROM warehouse.fact_maintenance)
) facts;
</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>EADP_POSTGRES</connection>
