      <attributes_kjc/>
    </entry>
    <entry>
      <name>LOG_MASTER_SUCCESS</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE audit.etl_execution_log
SET
    end_time = CURRENT_TIMESTAMP,
    status = 'SUCCESS'
WHERE execution_id = (
    SELECT MAX(execution_id)
    FROM audit.etl_execution_log
    WHERE job_name = 'EADP_MASTER'
      AND status = 'RUNNING'
);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
