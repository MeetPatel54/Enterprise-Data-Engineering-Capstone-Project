  <step>
    <name>dim_crew</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT DISTINCT
    TRIM(m.crew_id) AS crew_id,
    NULLIF(TRIM(m.crew_name), '') AS crew_name,
    NULLIF(TRIM(m.role), '') AS role,
    NULLIF(TRIM(m.airline), '') AS airline,
    NULLIF(TRIM(m.base_airport), '') AS base_airport
FROM master_data.crew m
WHERE m.crew_id IS NOT NULL
  AND TRIM(m.crew_id) &lt;&gt; ''
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_crew d
      WHERE TRIM(d.crew_id) = TRIM(m.crew_id)
  )
ORDER BY crew_id;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
