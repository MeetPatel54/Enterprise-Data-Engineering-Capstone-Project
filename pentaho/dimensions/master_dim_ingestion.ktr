    <connection>EADP_POSTGRES</connection>
    <sql>SELECT
    c.customer_id AS passenger_id,
    c.customer_id,
    c.passenger_name,
    c.age::INTEGER AS age,
    c.gender,
    c.city,
    c.country,
    c.email,
    c.phone,
    c.loyalty_level,
    c.customer_since,
    c.preferred_channel,
    c.total_flights,
    c.total_spend_inr,
    c.last_flight_date,
    c.loyalty_points,
    c.marketing_opt_in
FROM master_data.customer c
WHERE c.customer_id IS NOT NULL
  AND TRIM(c.customer_id) &lt;&gt; ''
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_passenger p
      WHERE p.customer_id = c.customer_id
  )
ORDER BY c.customer_id;</sql>
