    <connection>EADP_POSTGRES</connection>
    <sql>SELECT
    m.airport_id,
    m.airport_name,
    m.city,
    m.state_code,
    m.state_name,
    m.country_code,
    m.region_code,
    m.icao_id,
    m.latitude,
    m.longitude,
    m.elev AS elevation,
    m.site_type_code,
    m.ownership_type_code,
    m.facility_use_code,
    m.airport_status
FROM master_data.airport m
WHERE m.airport_id IS NOT NULL
  AND TRIM(m.airport_id) &lt;&gt; ''
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_airport d
      WHERE TRIM(d.airport_id) = TRIM(m.airport_id)
  )
ORDER BY m.airport_id;</sql>
