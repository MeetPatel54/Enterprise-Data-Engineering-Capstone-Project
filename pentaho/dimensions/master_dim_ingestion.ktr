  <step>
    <name>dim_airline</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT DISTINCT
    s.airline_name
FROM (
    SELECT TRIM(airline) AS airline_name
    FROM cleansed.flight_operations

    UNION ALL

    SELECT TRIM(airline)
    FROM cleansed.passenger_reservation

    UNION ALL

    SELECT TRIM(airline)
    FROM cleansed.flight_delay

    UNION ALL

    SELECT TRIM(airline)
    FROM cleansed.ticketing_booking

    UNION ALL

    SELECT TRIM(airline)
    FROM cleansed.crew_scheduling

    UNION ALL

    SELECT TRIM(airline)
    FROM cleansed.aircraft_iot

    UNION ALL

    SELECT TRIM(carrier_name)
    FROM cleansed.baggage_handling
) s
WHERE s.airline_name IS NOT NULL
  AND s.airline_name &lt;&gt; ''
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_airline da
      WHERE LOWER(TRIM(da.airline_name)) =
            LOWER(TRIM(s.airline_name))
  )
ORDER BY s.airline_name;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
