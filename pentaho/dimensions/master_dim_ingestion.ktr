  <step>
    <name>dim_flight</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT DISTINCT
    TRIM(m.flight_id) AS flight_id,
    NULLIF(TRIM(m.flight_number), '') AS flight_number,
    da.airline_key,
    origin_airport.airport_key AS origin_airport_key,
    destination_airport.airport_key AS destination_airport_key
FROM master_data.flight_final m
LEFT JOIN warehouse.dim_airline da
    ON LOWER(TRIM(da.airline_name)) = LOWER(TRIM(m.airline))
LEFT JOIN warehouse.dim_airport origin_airport
    ON LOWER(TRIM(origin_airport.airport_id)) = LOWER(TRIM(m.origin))
LEFT JOIN warehouse.dim_airport destination_airport
    ON LOWER(TRIM(destination_airport.airport_id)) = LOWER(TRIM(m.destination))
WHERE m.flight_id IS NOT NULL
  AND TRIM(m.flight_id) &lt;&gt; ''
  AND da.airline_key IS NOT NULL
  AND origin_airport.airport_key IS NOT NULL
  AND destination_airport.airport_key IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_flight existing
      WHERE TRIM(existing.flight_id) = TRIM(m.flight_id)
  )
ORDER BY flight_id;</sql>
    <limit>0</limit>
