  <step>
    <name>dim_aircraft</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT DISTINCT
    TRIM(m.aircraft_id) AS aircraft_id,
    NULLIF(TRIM(m.aircraft_type), '') AS aircraft_type,
    NULLIF(TRIM(m.airline), '') AS airline
FROM master_data.aircraft_final m
WHERE m.aircraft_id IS NOT NULL
  AND TRIM(m.aircraft_id) &lt;&gt; ''
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.dim_aircraft d
      WHERE TRIM(d.aircraft_id) = TRIM(m.aircraft_id)
  )
ORDER BY aircraft_id;</sql>
