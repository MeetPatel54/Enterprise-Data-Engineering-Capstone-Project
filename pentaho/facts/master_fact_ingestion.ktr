    <name>fact_maintainance</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT
    s.aircraft_id,
    a.aircraft_key,
    d.date_key AS last_execution_date_key,
    s.item,
    s.description,
    s.block,
    s.skill,
    s.mxh_est,
    s.per_fh,
    s.per_fc,
    s.per_calend,
    s.task_by_block,
    s.last_exec_insp,
    s.last_exec_fh,
    s.last_exec_fc,
    s.last_exec_dt,
    s.limit_insp,
    s.limit_fh
FROM cleansed.aircraft_maintenance s
JOIN warehouse.dim_aircraft a
    ON TRIM(a.aircraft_id) = TRIM(s.aircraft_id)
LEFT JOIN warehouse.dim_date d
    ON d.full_date = s.last_exec_dt;</sql>
