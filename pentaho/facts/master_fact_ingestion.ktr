  <step>
    <name>fact_booking</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>
SELECT
    s.ticket_id,
    s.booking_id,
    p.passenger_key,
    f.flight_key,
    a.airline_key,
    bd.date_key AS booking_date_key,
    td.date_key AS travel_date_key,
    s.fare_class,
    s.booking_channel,
    s.base_fare_inr,
    s.tax_inr,
    s.total_amount_inr,
    s.payment_method,
    s.payment_status,
    s.booking_status,
    s.seat_number,
    s.baggage_allowance_kg,
    s.meal_requested,
    s.cancellation_date,
    s.cancellation_reason,
    s.refund_amount_inr,
    s.refund_status
FROM cleansed.ticketing_booking s
JOIN warehouse.dim_passenger p
    ON TRIM(p.passenger_id) = TRIM(s.passenger_id)
JOIN warehouse.dim_flight f
    ON TRIM(f.flight_id) = TRIM(s.flight_id)
JOIN warehouse.dim_airline a
    ON LOWER(TRIM(a.airline_name)) = LOWER(TRIM(s.airline))
JOIN warehouse.dim_date bd
    ON bd.full_date = s.booking_date
JOIN warehouse.dim_date td
    ON td.full_date = s.travel_date
WHERE NOT EXISTS (
    SELECT 1
    FROM warehouse.fact_booking existing
    WHERE TRIM(existing.ticket_id) = TRIM(s.ticket_id)
);
</sql>
