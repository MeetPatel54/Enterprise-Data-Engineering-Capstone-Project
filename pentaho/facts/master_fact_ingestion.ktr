  <step>
    <name>fact_crew_scheduling</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT
    s.assignment_id,
    c.crew_key,
    f.flight_key,
    d.date_key,
    s.duty_start,
    s.duty_end,
    s.duty_hours,
    s.flight_hours,
    s.rest_hours_before_duty,
    s.experience_years,
    s.overtime_hours,
    s.leave_days_used,
    s.monthly_flight_hours,
    s.license_status,
    s.flight_type,
    s.duty_status
FROM cleansed.crew_scheduling s
JOIN warehouse.dim_crew c
    ON TRIM(c.crew_id) = TRIM(s.crew_id)
JOIN warehouse.dim_flight f
    ON TRIM(f.flight_id) = TRIM(s.flight_id)
JOIN warehouse.dim_date d
    ON d.full_date = s.duty_date;</sql>
