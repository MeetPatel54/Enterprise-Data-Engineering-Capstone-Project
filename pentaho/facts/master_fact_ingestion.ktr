  <step>
    <name>fact_flight_operation</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>
WITH source_data AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                date_of_journey,
                airline,
                source,
                destination,
                dep_time,
                duration,
                total_stops,
                price,
                additional_info
        ) AS generated_source_row_id,
        date_of_journey::date AS journey_date,
        TRIM(airline) AS airline,
        TRIM(source) AS origin_city,
        TRIM(destination) AS destination_city,
        TRIM(dep_time) AS departure_time_text,
        TRIM(duration) AS duration_text,
        total_stops,
        price::numeric AS price_inr,
        additional_info
    FROM cleansed.flight_operations
),
normalized AS (
    SELECT
        s.*,
        CASE LOWER(origin_city)
            WHEN 'banglore' THEN 'BLR'
            WHEN 'bangalore' THEN 'BLR'
            WHEN 'chennai' THEN 'MAA'
            WHEN 'cochin' THEN 'COK'
            WHEN 'delhi' THEN 'DEL'
            WHEN 'new delhi' THEN 'DEL'
            WHEN 'hyderabad' THEN 'HYD'
            WHEN 'kolkata' THEN 'CCU'
            WHEN 'mumbai' THEN 'BOM'
            ELSE 'UNKNOWN'
        END AS origin_code,
        CASE LOWER(destination_city)
            WHEN 'banglore' THEN 'BLR'
            WHEN 'bangalore' THEN 'BLR'
            WHEN 'chennai' THEN 'MAA'
            WHEN 'cochin' THEN 'COK'
            WHEN 'delhi' THEN 'DEL'
            WHEN 'new delhi' THEN 'DEL'
            WHEN 'hyderabad' THEN 'HYD'
            WHEN 'kolkata' THEN 'CCU'
            WHEN 'mumbai' THEN 'BOM'
            ELSE 'UNKNOWN'
        END AS destination_code
    FROM source_data s
)
SELECT
    n.generated_source_row_id AS source_row_id,
    d.date_key,
    al.airline_key,
    COALESCE(oa.airport_key, u.airport_key) AS origin_airport_key,
    COALESCE(da.airport_key, u.airport_key) AS destination_airport_key,
    n.departure_time_text::time AS departure_time,
    (
        COALESCE(
            (regexp_match(n.duration_text, '([0-9]+)\s*h'))[1]::integer,
            0
        ) * 60
        +
        COALESCE(
            (regexp_match(n.duration_text, '([0-9]+)\s*m'))[1]::integer,
            0
        )
    ) AS duration_minutes,
    n.total_stops,
    n.price_inr,
    n.additional_info
FROM normalized n
JOIN warehouse.dim_date d
    ON d.full_date = n.journey_date
JOIN warehouse.dim_airline al
    ON LOWER(TRIM(al.airline_name)) = LOWER(n.airline)
LEFT JOIN warehouse.dim_airport oa
    ON UPPER(TRIM(oa.airport_id)) = n.origin_code
LEFT JOIN warehouse.dim_airport da
    ON UPPER(TRIM(da.airport_id)) = n.destination_code
JOIN warehouse.dim_airport u
    ON UPPER(TRIM(u.airport_id)) = 'UNKNOWN'
ORDER BY n.generated_source_row_id;
</sql>
    <limit>0</limit>
