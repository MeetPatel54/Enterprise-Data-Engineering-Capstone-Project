  <step>
    <name>fact_baggage</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>
SELECT
    d.date_key,
    a.airline_key,
    s.passengers,
    s.mishandled_baggage,
    s.enplaned_baggage,
    s.mishandled_wchr_sctr,
    s.enplaned_wchr_sctr,
    s.form_type
FROM cleansed.baggage_handling_demo s
JOIN warehouse.dim_date d
    ON d.full_date = MAKE_DATE(
        s.year::integer,
        s.month::integer,
        1
    )
JOIN warehouse.dim_airline a
    ON LOWER(TRIM(a.airline_name))
       = LOWER(TRIM(s.carrier_name));
</sql>
