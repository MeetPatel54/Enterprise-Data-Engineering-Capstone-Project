  <step>
    <name>fact_aircraft-iot</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>SELECT
    s.log_id,
    a.aircraft_key,
    d.date_key,
    s.aircraft_type,
    s.airline,
    s.timestamp AS sensor_timestamp,
    s.sensor_type,
    s.engine_temperature_c,
    s.oil_pressure_psi,
    s.vibration_mm_s,
    s.fuel_flow_kg_h,
    s.altitude_ft,
    s.speed_kmh,
    s.latitude,
    s.longitude,
    s.cabin_temperature_c,
    s.humidity_percent,
    s.cabin_pressure_kpa,
    s.fuel_level_percent,
    s.hydraulic_pressure_psi,
    s.sensor_status
FROM cleansed.aircraft_iot s
JOIN warehouse.dim_aircraft a
    ON TRIM(a.aircraft_id) = TRIM(s.aircraft_id)
JOIN warehouse.dim_date d
    ON d.full_date = s.timestamp::date;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
