  <step>
    <name>fact_flight_delay</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>EADP_POSTGRES</connection>
    <sql>
SELECT
    s.delay_id,
    d.date_key,
    fl.flight_key,
    a.airline_key
FROM cleansed.flight_delay s
JOIN warehouse.dim_date d
    ON d.full_date = s.date
JOIN warehouse.dim_flight fl
    ON TRIM(fl.flight_id) = TRIM(s.flight_id)
JOIN warehouse.dim_airline a
    ON LOWER(TRIM(a.airline_name)) = LOWER(TRIM(s.airline));
</sql>
